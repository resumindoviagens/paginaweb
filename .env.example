# OPENAI — somente no servidor da Vercel
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# BREVO — somente no servidor da Vercel
BREVO_API_KEY=

# SUPABASE — projeto separado exclusivo da orientação online
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública/publishable. Pode ser entregue ao navegador, mas o acesso é protegido por RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_
# Chave secreta do servidor. Nunca inserir no HTML, script.js ou GitHub.
SUPABASE_SECRET_KEY=sb_secret_

# Segredo aleatório usado pela rotina diária de recuperação de relatórios e limpeza da Vercel.
CRON_SECRET=
