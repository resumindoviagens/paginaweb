# Chave da API OpenAI. Nunca coloque esta chave no index.html ou script.js.
OPENAI_API_KEY=

# Modelo sugerido para volume e custo. Pode ser alterado na Vercel.
OPENAI_MODEL=gpt-5.6-luna

# Chave da API transacional Brevo.
BREVO_API_KEY=

# Destinatário dos resumos das conversas.
CHAT_EMAIL_TO=contato@resumindoviagens.com.br

# Remetente já autenticado no Brevo.
CHAT_EMAIL_FROM=contato@resumindoviagens.com.br
CHAT_EMAIL_FROM_NAME=Chatbox Resumindo Viagens
